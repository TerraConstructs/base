# Single source of truth for the AWS emulator image used by the integration tests.
# Read by integ/common.mk (local runs) and projenrc/github-workflows.ts (CI).
# Plain KEY=value lines: no quotes, no spaces, no export, no variable expansion.
#
# EMULATOR_IMAGE is pinned by the digest of the multi-arch index, so a new tag
# push cannot change what runs. The tag only documents the emulator version.
# To bump, get the new digest and edit EMULATOR_IMAGE, then run `pnpm exec projen`:
#   docker buildx imagetools inspect ghcr.io/terraconstructs/aws-emulator:<version>
EMULATOR_IMAGE=ghcr.io/terraconstructs/aws-emulator:1.0.598.1@sha256:dd2f8609f8ed2854369bf9fd639a7ee04facec9d9984e6f769da691809743577
# Keyless cosign signing identity of the aws-emulator-docker release workflow.
EMULATOR_IMAGE_SIGNER=https://github.com/TerraConstructs/aws-emulator-docker/.github/workflows/release.yml@refs/heads/main
